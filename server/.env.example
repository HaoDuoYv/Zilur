# ─────────────────────────────────────────────────────────────
# 知录 · 云端服务端 环境变量模板
#
# 用法：复制成 .env 后填写。**.env 已在 .gitignore 里排除，别提交。**
#   cp .env.example .env
#
# 只填你需要的：这个服务端是**可选的**，不部署它，App 仍然完全可用。
# ─────────────────────────────────────────────────────────────

# ── 必填 ──────────────────────────────────────────────────────

# JWT 签名密钥。**必须自己生成一串随机值**，不要用示例值。
#   openssl rand -hex 32
# 换掉它会让所有已登录的设备掉线（需要重新登录），这属于预期行为。
JWT_SECRET=

# ── 监听与存储 ────────────────────────────────────────────────

# 容器内端口（一般不用改；要改对外端口请改 compose 里的 ports 或下面的 PORT 映射）
PORT=8787

# 数据目录：数据库、头像、备份都放这里。Docker 里对应 ./data 卷。
DATA_DIR=/data

# 令牌有效期（天）。过期后 App 会要求重新登录。
JWT_TTL_DAYS=30

# 允许的跨域来源。App 不需要跨域，留空即可；用浏览器调试后台可填 *
CORS_ORIGIN=

# 反代（Nginx / Caddy / 云厂商负载均衡）后面部署时设 true，
# 这样限流与日志能拿到真实客户端 IP。直接暴露端口则保持 false。
TRUST_PROXY=false

# ── 邮件（找回密码 / 注册验证码）────────────────────────────────

# 留空 = 未配置邮件服务：注册将不要求验证码，找回密码功能返回"未配置邮件服务"。
# 常用配置：
#   QQ 邮箱      smtp.qq.com      465  secure=true
#   163 邮箱     smtp.163.com     465  secure=true
#   Gmail        smtp.gmail.com   465  secure=true
#   阿里云邮件推送 smtpdm.aliyun.com 465 secure=true
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true

# SMTP 用户名（通常是完整邮箱地址）
SMTP_USER=

# **授权码 / 应用专用密码** —— 就是这里要你填的那一项。
# 注意：QQ/163 的授权码不是登录密码，需要在邮箱设置里单独开启 SMTP 服务后获取。
SMTP_PASS=

# 发件人显示。留空则用 SMTP_USER。
# 例：知录 <noreply@example.com>
MAIL_FROM=

# 注册是否要求邮箱验证码。邮件未配置时这项自动失效（按 false 处理）。
REQUIRE_EMAIL_VERIFICATION=true

# ── 配额 ──────────────────────────────────────────────────────

# 头像大小上限（MB）
MAX_AVATAR_MB=2

# 云端备份大小上限（MB）。.dtk 含图片，图库大时请按需调高。
MAX_BACKUP_MB=128

# 是否开放注册。自己用的服务器可以先注册完再把这项关掉。
REGISTRATION_ENABLED=true

# 验证码有效期（分钟）与发送冷却（秒）
CODE_TTL_MINUTES=10
CODE_COOLDOWN_SECONDS=60
